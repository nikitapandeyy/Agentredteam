# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env — it is gitignored.

# Groq — runs the target agent (https://console.groq.com/keys)
GROQ_API_KEY=

# Gemini — generates attacks and judges results (https://aistudio.google.com)
GEMINI_API_KEY=

# PostgreSQL connection string (set up in Task 13)
DATABASE_URL=

# Model choices
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
